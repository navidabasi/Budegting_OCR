{
  "functions": {
    "api/ocr.py": {
      "runtime": "python3.11",
      "memory": 1024,
      "maxDuration": 60
    },
    "api/ocr-proxy.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/ocr",
      "destination": "/api/ocr.py"
    }
  ]
}
